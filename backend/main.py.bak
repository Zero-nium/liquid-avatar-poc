@app.get("/health")
async def health():
    return {"status": "ok", "schema_version": SCHEMA_VERSION, "origin": "Aura Quorum"}

# ─── STATIC FILES (FRONTEND) ──────────────────────────────────────────────────

# Serve frontend files from sibling directory
if os.path.exists(FRONTEND_DIR):
    app.mount("/", StaticFiles(directory=FRONTEND_DIR, html=True), name="frontend")
else:
    @app.get("/")
    async def root():
        return {
            "message": "Liquid Avatar API",
            "schema_version": SCHEMA_VERSION,
            "council": "Aura Quorum",
            "note": "Frontend not found. Ensure frontend/ directory exists alongside backend/"
        }

